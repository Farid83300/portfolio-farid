DB_HOST=127.0.0.1
DB_NAME=portfolio_farid
DB_USER=root
DB_PASS=root

# SÉCURITÉ: secret fort obligatoire (>= 32 caractères aléatoires, jamais cette valeur
# d'exemple) — AuthService refuse de démarrer sinon. Génère-en un avec :
#   php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=change_moi_avec_un_secret_genere_via_php
# SÉCURITÉ: durée de vie courte de l'access token (30 min) — la session longue durée
# est portée par le refresh token (rotatif, révocable), pas par ce JWT.
JWT_EXPIRE=1800
# SÉCURITÉ: durée de vie du refresh token (30 jours) avant réauthentification complète.
REFRESH_TOKEN_EXPIRE=2592000

# SÉCURITÉ: whitelist stricte des origines autorisées en CORS — une ou plusieurs,
# séparées par des virgules (ex. domaine principal + www + preview Vercel). Jamais de
# wildcard "*". En prod, remplace par les vrais domaines du frontend (Vercel/domaine perso).
CORS_ORIGIN=http://localhost:3000

MAIL_TO=contact@faridzaffalone.com

# Base URL of this backend as reachable from the browser (used to build absolute upload URLs)
APP_URL=http://localhost:8888/portfolio-farid-backend/public

# SÉCURITÉ: 'production' cache les erreurs PHP au client et les journalise dans un fichier
# (voir public/index.php) — à ne mettre sur 'development' qu'en local pour voir les erreurs.
APP_ENV=development
